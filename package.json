{
  "name": "jidai-sensen",
  "private": true,
  "version": "2.5.0",
  "description": "時代戦線 序戦 ── 原始から現代まで、六つの時代を駆け上がる横画面タワーディフェンス",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run check && cross-env VITE_TARGET=web vite build && node scripts/stamp-sw.mjs dist/web",
    "build:desktop": "cross-env VITE_TARGET=desktop vite build",
    "preview": "vite preview --outDir dist/web",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run validate:master && pnpm run test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,css,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,css,json,md,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:master": "tsx scripts/validate-master.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "pnpm run check && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
