# アカウント機能（ブラウザ版だけ）の設定。
# このファイルを .env という名前で複製し、値を入れてください。
# 値が無いとアカウント機能は現れず、ゲームは端末の中だけで進行を持ちます。
#
# 取り方は docs/ACCOUNT.md を見てください。

# Supabase プロジェクトの URL。例: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# 公開鍵（anon / publishable key）。
# これはブラウザに配って良い鍵です。
# service_role の鍵は絶対にここへ書かないこと ── あれは全権を持ちます。
VITE_SUPABASE_ANON_KEY=
